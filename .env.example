# DATABASE_URL: PostgreSQL connection string (Supabase Transaction Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct or pooler URL used by Prisma for migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted
APP_URL=
